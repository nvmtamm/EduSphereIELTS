# ==============================================================================
# EduSphere - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Infrastructure (Docker Compose)
# ------------------------------------------------------------------------------
SA_PASSWORD=EduSphere@2026StrongPass!

# ------------------------------------------------------------------------------
# 2. JWT Security (Backend)
# ------------------------------------------------------------------------------
JWT_SECRET=EduSphereSuperSecureSecretKeyForSigningJwtTokens2026!
JWT_ISSUER=https://api.edusphere.io
JWT_AUDIENCE=https://edusphere.io

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (Backend & Frontend)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Gmail SMTP Email Service (Backend)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=EduSphere IELTS Official
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_ENABLE=true

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 6. Dedicated Google Gemini API Keys Per Agent & RAG Subsystem
# ------------------------------------------------------------------------------
# Fallback / Default Key
GEMINI_API_KEY=your-gemini-key-1

# Multi-Agent Ingestion Pipeline (4 Dedicated Keys)
GEMINI_API_KEY_INGESTION=your-gemini-key-for-doc-ingestion
GEMINI_API_KEY_STRUCTURING=your-gemini-key-for-passage-structuring
GEMINI_API_KEY_PARSER=your-gemini-key-for-question-parsing
GEMINI_API_KEY_VERIFIER=your-gemini-key-for-quality-verification

# RAG & AI Tutor Subsystems (3 Dedicated Keys)
GEMINI_API_KEY_RAG_TUTOR=your-gemini-key-for-exam-ai-tutor
GEMINI_API_KEY_EMBEDDING=your-gemini-key-for-vector-embeddings
GEMINI_API_KEY_GENERATOR=your-gemini-key-for-ai-test-generation

# Model Selection
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 7. Qdrant Vector Store
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
